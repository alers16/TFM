# =============================================================================
# Configuración de credenciales para la campaña real de RQ3
# =============================================================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subas .env al repositorio — está excluido en .gitignore.
#
# Las variables se leen con System.getenv() desde LlmApiConfig.
# Importante: Java NO carga .env automáticamente.
# Para IntelliJ: Run → Edit Configurations → Environment variables.
# Para terminal: export OPENAI_API_KEY=sk-... (Linux/Mac) o $env:OPENAI_API_KEY="sk-..." (PowerShell)
# =============================================================================

# OpenAI (única credencial necesaria desde fase 9.6: campaña formal gpt-4o vs gpt-4.1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_SECONDARY_MODEL=gpt-4.1

